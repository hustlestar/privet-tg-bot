# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Provider Configuration
# Use "mock" for local testing without API calls
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/learn-words

# Bot Settings (Optional)
MAX_TRAINING_WORDS=10
DEFAULT_RESPONSE_MODE=medium

# Language Configuration
SUPPORTED_INTERFACE_LANGUAGES=english,spanish,russian,polish
SUPPORTED_LEARNING_LANGUAGES=english,spanish,french,german,italian,portuguese,russian,polish

# Notifications configs
REPETITION_NOTIFICATION_INTERVAL_MINUTES=30
CLEANUP_OLD_NOTIFICATIONS_INTERVAL_HOURS=24