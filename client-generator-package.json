{
  "name": "privet-api-client-generator",
  "version": "1.0.0",
  "description": "OpenAPI client generator for Privet API",
  "scripts": {
    "generate": "python generate_api_client.py",
    "generate:watch": "nodemon --watch privet_api --ext py --exec 'python generate_api_client.py'"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "nodemon": "^3.0.1"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "typescript": "^5.3.0"
  }
}