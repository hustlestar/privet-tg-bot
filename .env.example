# Telegram Bot Template Configuration
# Copy this file to .env and fill in your values

# Required Settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/botdb

# Optional - OpenRouter AI Integration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# TTS Provider Configuration
# Options: elevenlabs, openai, google, amazon
TTS_PROVIDER=elevenlabs

# Optional TTS settings
TTS_VOICE=Rachel  # Provider-specific voice ID/name
TTS_LANGUAGE=en-US  # Language code
TTS_MODEL=  # Optional model selection (e.g., tts-1-hd for OpenAI)

# Speech Services API Keys
# OpenAI - Used for STT (Whisper) and optionally for TTS
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs - High-quality voice synthesis with emotions
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Cloud TTS - Requires service account JSON path or JSON string
# GOOGLE_TTS_API_KEY=/path/to/service-account.json

# Amazon Polly - Format: access_key,secret_key,region
# AMAZON_POLLY_API_KEY=AKIAIOSFODNN7EXAMPLE,wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY,us-east-1
# Optional - Support Bot (if you want support functionality)
SUPPORT_BOT_TOKEN=your_support_bot_token_here
SUPPORT_CHAT_ID=your_support_chat_id_here

# Optional - Maintainer Chat ID (for critical alerts)
MAINTAINER_CHAT_ID=66395090

# Optional - Bot Metadata
BOT_NAME=My Telegram Bot
BOT_DESCRIPTION=A simple and clean Telegram bot
BOT_VERSION=1.0.0

# Optional - Localization Settings
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ru,es

# Optional - Logging Configuration
LOG_LEVEL=INFO

# Optional - Development Settings
AUTO_MIGRATE=true
# Uncomment for development/testing
# DEBUG=true